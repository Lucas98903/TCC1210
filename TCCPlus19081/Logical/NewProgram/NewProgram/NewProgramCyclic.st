PROGRAM _INIT
	Theta[0] := 0.0;
	Theta[1] := 0.0;

	P[0,0] := 1000.0;
	P[0,1] := 0.0;
	P[1,0] := 0.0;
	P[1,1] := 1000.0;

	Lambda := 0.5;

	y_prev := 0.0;
	u_prev := 0.0;
	
	Sys.T1 := 10;
	Sys.V  := 1;
	Sys();
	
END_PROGRAM
	
PROGRAM _CYCLIC

// =====================================================
// MÍNIMOS QUADRADOS RECURSIVO - SISTEMA DE 0ª ORDEM
//
// Modelo:
// y(k) = a*y(k-0) + b*u(k-0)
// =====================================================

// Entradas:
// u  -> entrada atual
// y  -> saída atual

// Parâmetros:
// Theta[0] = a
// Theta[1] = b

// ---------------------------------------------
// 0. Vetor de regressão
// ---------------------------------------------

	IF(Start) THEN
	
		Sys.enable	:= TRUE;
		Sys.x		:= 1;
		y := Sys.y;
		u := Sys.x;
		Sys();
	
	
	Phi[0] := y_prev;
	Phi[1] := u_prev;


	// ---------------------------------------------
	// 1. Predição da saída
	// ---------------------------------------------

	Y_hat := Phi[0] * Theta[0]
	+ Phi[1] * Theta[1];


	// ---------------------------------------------
	// 3. Erro de estimação
	// ---------------------------------------------

	Error := y - Y_hat;


	// ---------------------------------------------
	// 4. Cálculo do denominador
	// ---------------------------------------------

	Den := Lambda
	+ Phi[0] * (P[0,0] * Phi[0] + P[0,1] * Phi[1])
	+ Phi[1] * (P[1,0] * Phi[0] + P[1,1] * Phi[1]);


	// ---------------------------------------------
	// 5. Ganho K
	// ---------------------------------------------

	K[0] := (P[0,0] * Phi[0]
	+ P[0,1] * Phi[1]) / Den;

	K[1] := (P[1,0] * Phi[0]
	+ P[1,1] * Phi[1]) / Den;


	// ---------------------------------------------
	// 6. Atualização dos parâmetros
	// ---------------------------------------------

	Theta[0] := Theta[0] + K[0] * Error;

	Theta[1] := Theta[1] + K[1] * Error;


	// ---------------------------------------------
	// 7. Atualização da matriz P
	// ---------------------------------------------

	P00_old := P[0,0];
	P01_old := P[0,1];
	P10_old := P[1,0];
	P11_old := P[1,1];

	P[0,0] := (P00_old - K[0] *
	(Phi[0] * P00_old +
	Phi[1] * P01_old)) / Lambda;

	P[0,1] := (P01_old - K[0] *
	(Phi[0] * P01_old +
	Phi[1] * P11_old)) / Lambda;

	P[1,0] := (P10_old - K[1] *
	(Phi[0] * P00_old +
	Phi[1] * P10_old)) / Lambda;

	P[1,1] := (P11_old - K[1] *
	(Phi[0] * P01_old +
	Phi[1] * P11_old)) / Lambda;


	// ---------------------------------------------
	// 8. Armazenamento das amostras anteriores
	// ---------------------------------------------

	y_prev := y;
	u_prev := u;

	END_IF
	
END_PROGRAM
